#!/usr/bin/env bash
#
# Launcher for the lyricist service.
#
# Works both straight out of the git checkout (where bin/ sits next to the
# lyricist/ package) and from an installed copy in ~/.local (where the package
# lives in ~/.local/lib/lyricist).
#
set -euo pipefail

self="$(readlink -f "${BASH_SOURCE[0]}")"
here="$(dirname "$self")"

if [[ -d "$here/../lyricist" ]]; then
    root="$(cd "$here/.." && pwd)"
else
    root="${LYRICIST_LIB:-$HOME/.local/lib/lyricist}"
fi

export PYTHONPATH="$root${PYTHONPATH:+:$PYTHONPATH}"
exec python3 -m lyricist "$@"
