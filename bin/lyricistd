# SPDX-License-Identifier: MIT

#
# Launcher for the lyricist service.
#
# Works straight out of the git checkout (bin/ next to the lyricist/ package) and
# from an installed copy (<prefix>/lib/lyricist, ~/.local by default).
#
set -euo pipefail

self="$(readlink -f "${BASH_SOURCE[0]}")"
here="$(dirname "$self")"

if [[ -d "$here/../lyricist" ]]; then
    root="$(cd "$here/.." && pwd)"            # a git checkout: bin/ next to lyricist/
elif [[ -d "$here/../lib/lyricist/lyricist" ]]; then
    root="$(cd "$here/../lib/lyricist" && pwd)"   # installed under a prefix
else
    root="${LYRICIST_LIB:-$HOME/.local/lib/lyricist}"
fi

export PYTHONPATH="$root${PYTHONPATH:+:$PYTHONPATH}"
exec python3 -m lyricist "$@"
